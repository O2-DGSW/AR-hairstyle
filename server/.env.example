# server/.env 로 복사해서 쓴다 (커밋 금지 - .gitignore). 서버가 뜰 때 config.py 가 읽는다.
# 실제 환경변수가 있으면 그쪽이 이긴다. 키는 config.py 필드명을 HEDDY_ + 대문자로.

# 동시 접속 상한
HEDDY_MAX_SESSIONS=3

# 꽉 찼을 때 /offer 를 넘길 다른 heddy 서버들 (쉼표 구분, 순서대로 시도).
# Tailscale 이면 MagicDNS 이름보다 IP 가 빠르다(Windows 이름 조회 ~2초).
# HEDDY_REMOTE_BACKENDS=http://<원격 서버 주소>:8080

# 1 이면 매 세션 원격부터 시도하고, 원격이 닿지 않거나 꽉 찼을 때만 이 서버가 받는다.
# HEDDY_PREFER_REMOTE=1

# WebRTC STUN 서버. 랜카드에 공인 IP 가 직접 붙은 서버면 비워서 연결 지연(~7초)을 없앤다.
# NAT 뒤 서버(공유기/도커)는 비우면 폰이 못 붙는다 - 그대로 둘 것.
# HEDDY_ICE_SERVERS=
